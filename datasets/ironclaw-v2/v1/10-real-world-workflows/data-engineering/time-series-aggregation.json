  "timeout_secs": 180,
  "max_tool_iterations": 25,
  "turns": [
    {
      "user_input": "Load the sensor data from data/sensor.json. What's the sampling frequency and total duration of readings?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(frequency|second|duration|interval|sample)",
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "Resample to 1-minute averages. How many data points do we have after resampling?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(resample|minute|average|data point)"
      }
    },
    {
      "user_input": "There are gaps in the data where readings are missing. Identify the gaps and fill them using linear interpolation.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(gap|interpolat|missing|fill)"
      }
    },
    {
      "user_input": "Some readings spike to 999.9 — those are sensor errors. How many are there? Replace them with interpolated values.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(999|spike|sensor error|replaced|glitch)"
      }
    },
    {
      "user_input": "Calculate the rolling 5-second average and standard deviation across the cleaned data.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(rolling|average|standard deviation|window)"
      }
    },
    {
      "user_input": "When did the sensor readings exceed 2 standard deviations from the rolling mean? Identify the anomalous periods.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(anomal|exceed|deviation|outlier|period)",
        "response_not_contains": ["LLM error"]
      }
    }
  ]
}
