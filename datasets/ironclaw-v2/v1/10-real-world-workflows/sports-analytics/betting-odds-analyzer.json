  "timeout_secs": 180,
  "max_tool_iterations": 25,
  "turns": [
    {
      "user_input": "Load the odds data from data/odds.json. Convert all moneyline odds to implied probabilities for every game across all 3 bookmakers. Show the average implied probability for each side.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(implied|probabilit|%)",
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "Where do the bookmakers disagree most? Find the games with the largest spread in implied probabilities across the 3 books. These discrepancies could indicate value opportunities.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(disagree|discrepanc|difference|spread|value)"
      }
    },
    {
      "user_input": "Load my model predictions from data/my_model.json. Cross-reference with the market odds. Where does my model differ from the average market implied probability by more than 5 percentage points?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(model|market|differ|5%|edge|disagree)"
      }
    },
    {
      "user_input": "Calculate the expected value of each potential moneyline bet using my model's probabilities versus the best available odds across the 3 bookmakers.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(expected value|EV|positive|negative)"
      }
    },
    {
      "user_input": "Which bets have positive expected value? For those, show the Kelly criterion optimal bet sizing assuming a $10,000 bankroll. Include your responsible gambling disclaimer.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(Kelly|responsible|risk|gambl|bankroll)",
        "response_not_contains": ["LLM error"]
      }
    }
  ]
