  "turns": [
    {
      "user_input": "Load the projections from data/projections.csv and scoring rules from data/scoring_rules.json. Calculate the expected fantasy points per game for each player.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_contains": ["Jokic", "Doncic"],
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "I have the 5th pick in a 12-team snake draft. Simulate the first 4 picks based on ADP and tell me who's likely available at pick 5.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(pick|available|5th|draft)"
      }
    },
    {
      "user_input": "Between LeBron and Jokic (assuming both are available), who gives me better value based on total projected fantasy points for the season? Factor in games played.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(Jokic|LeBron)"
      }
    },
    {
      "user_input": "My first 3 picks are Jokic, Haliburton, and Anthony Edwards. What positions should I target next? Show me the best available player at each position of need.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(PG|SG|SF|PF|C|position|target)"
      }
    },
    {
      "user_input": "Identify the top 5 sleeper picks - players ranked 80+ in ADP who project in the top 50 by your fantasy scoring calculations.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(sleeper|value|undervalued)"
      }
    },
    {
      "user_input": "Generate my optimal 13-player roster strategy for the full draft. Show me who to target in each round with my snake draft position.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(round|roster|strategy|draft)",
