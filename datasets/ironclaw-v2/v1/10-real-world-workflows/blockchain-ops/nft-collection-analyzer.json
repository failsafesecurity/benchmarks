  "timeout_secs": 180,
  "max_tool_iterations": 25,
  "turns": [
    {
      "user_input": "Load the sales data from data/nft_sales.json and calculate the floor price, average sale price, and total volume.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_contains": ["floor"],
        "response_matches": "\\d+\\.?\\d*",
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "Show the price trend over time. Is the collection appreciating or depreciating?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(appreciat|depreciat|trend)"
      }
    },
    {
      "user_input": "Identify the top 5 'whale' buyers by total spend.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)whale"
      }
    },
    {
      "user_input": "What's the distribution of holding periods? How long do people hold before reselling?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(day|hold|period)"
      }
    },
    {
      "user_input": "One address bought 8 NFTs. Is there evidence of wash trading? Check if there are circular patterns.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(wash|circular|suspicious)"
      }
    },
    {
      "user_input": "Generate a collection health report: volume trend, holder distribution, concentration risk.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(report|health)",
        "response_not_contains": ["LLM error"]
      }
    }
  ]
