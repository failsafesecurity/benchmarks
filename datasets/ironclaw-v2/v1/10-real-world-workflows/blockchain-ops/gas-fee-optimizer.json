  "turns": [
    {
      "user_input": "Load the gas data from data/gas_prices.json and find the average gas price by hour of day (0-23 UTC).",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "\\d+\\.?\\d*",
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "What day of the week has the lowest average gas price?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)"
      }
    },
    {
      "user_input": "I need to send 5 transactions. Each needs at least 21000 gas. Find the cheapest 5-hour consecutive window in the next day's predicted pattern.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(gwei|window)"
      }
    },
    {
      "user_input": "What if my transactions are urgent and must go within the next 4 hours? What's the cost vs waiting for the optimal window?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "\\d+\\.?\\d*"
      }
    },
    {
      "user_input": "One of my transactions is a contract deployment needing 3,000,000 gas. When should I send that one specifically?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(deploy|3.?000.?000|gwei)"
      }
    },
    {
      "user_input": "Generate a scheduling plan for all 5 transactions to minimize total gas cost.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(schedule|plan)",
        "response_not_contains": ["LLM error"]
      }
    }
