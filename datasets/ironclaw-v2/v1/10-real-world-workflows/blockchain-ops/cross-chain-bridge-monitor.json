  "timeout_secs": 180,
  "max_tool_iterations": 25,
  "turns": [
    {
      "user_input": "Load the bridge data from data/bridge_txs.json and summarize: total volume, transaction count, unique users per chain.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "\\d+",
        "response_not_contains": ["LLM error"]
      }
    },
    {
      "user_input": "Calculate the average bridge completion time and flag any transactions that took more than 2x the average. Also check for any with unusual status.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(pending|BR-011|flag)"
      }
    },
    {
      "user_input": "Three large transactions came from the same address within 5 minutes (BR-003, BR-004, BR-005). Analyze this pattern.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(MarketMaker|rapid|pattern|rebalanc)"
      }
    },
    {
      "user_input": "That address was actually our market maker doing routine rebalancing -- mark those as legitimate.",
      "assertions": {
        "response_matches": "(?i)(legitimate|market.?maker|cleared|acknowledged)"
      }
    },
    {
      "user_input": "Now look for transactions where the source amount and destination amount differ by more than 0.5% (beyond normal fees).",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(mismatch|discrepan|differ|BR-008|BR-014|BR-011)"
      }
    },
    {
      "user_input": "BR-011 shows a user bridging 625 ETH but the destination never received it. This could be a stuck tx or exploit -- what data do we need to investigate?",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(stuck|pending|investig|625)"
      }
    },
    {
      "user_input": "Generate an alert report for the security team covering all anomalies found.",
      "assertions": {
        "tools_used": ["execute_code"],
        "response_matches": "(?i)(alert|security)",
        "response_not_contains": ["LLM error"]
      }
    }
  ]
}