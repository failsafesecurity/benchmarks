# Environment variables for the benchmark harness
# Copy to .env and fill in for the runs you intend to do.

# ── Red attacker (always required) ──────────────────────────────────────────
# GPT-5 with high reasoning effort. Used as the adversary for every cell.
OPENAI_API_KEY=

# ── Blue model API keys (set for the cells you'll run) ──────────────────────
# Claude Sonnet 4.6 (Anthropic API direct):
ANTHROPIC_API_KEY=

# GLM-5, Qwen-3.5, Kimi K2.6 (via OpenRouter):
OPENROUTER_API_KEY=

# ── Reasoning shim proxy ────────────────────────────────────────────────────
# Port for the shim proxy when running thinking models (Qwen, Kimi).
# Default is 8085. The harness will start the proxy automatically if not
# already running.
PROXY_PORT=8085

# ── Framework-specific ──────────────────────────────────────────────────────
# Docker container names for Ironclaw and Openclaw (which run in containers).
# Override if you're running multiple containers in parallel.
IRONCLAW_CONTAINER=ironclaw
OPENCLAW_CONTAINER=openclaw

# ── Optional: cost / rate-limit knobs ───────────────────────────────────────
# REDFORGE_MAX_COST_USD=50           # halt if spent exceeds this
# REDFORGE_RATE_LIMIT_RPM=60         # cap requests per minute
